# Ollama API URL
OLLAMA_URL=http://localhost:11434

# Default model to use for translations
DEFAULT_MODEL=translategemma:27b

# Set to "true" only when deployed behind a trusted reverse proxy (e.g. nginx)
# that sets the X-Forwarded-For header. Never set on direct-internet deployments.
TRUST_PROXY=false

# Source-language auto-detection engine: "lite" (CLD3, ~20 MB) or "accurate" (GlotLID v4, ~500 MB;
# run `npm run fetch:glotlid` first when not using Docker)
LANGUAGE_DETECTOR=lite

# Load the detector when the server starts ("true") or on the first auto-detect request ("false")
LANGUAGE_DETECTOR_PRELOAD=false

# Unload the detector after this much idle time, like Ollama's keep_alive: 30s, 5m, 1h or plain
# seconds. A negative value keeps it loaded; 0 unloads it after each request.
LANGUAGE_DETECTOR_KEEP_ALIVE=5m
